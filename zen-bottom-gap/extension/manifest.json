{
  "manifest_version": 3,
  "name": "Bottom Gap — по сайтам",
  "version": "2.3.0",
  "description": "Добавляет пустое место в конце страницы только на выбранных сайтах.",
  "browser_specific_settings": {
    "gecko": {
      "id": "bottom-gap-20@local",
      "strict_min_version": "115.0"
    }
  },
  "permissions": [
    "storage",
    "activeTab"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Bottom Gap",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png",
      "128": "icons/icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "gap.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
